{
    "name": "opensendform/osf-php",
    "description": "openSendForm (osf-php) — a free, open-source, self-hostable PHP form-to-email app for shared cPanel/PHP hosting.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "php-di/php-di": "^7",
        "phpmailer/phpmailer": "^6",
        "slim/psr7": "^1",
        "slim/slim": "^4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "OpenSendForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenSendForm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "XDEBUG_MODE=off phpunit",
        "serve": "php -S 0.0.0.0:8080 -t public public/dev-router.php"
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
