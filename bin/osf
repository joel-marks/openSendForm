#!/usr/bin/env php
<?php

declare(strict_types=1);

use OpenSendForm\Auth\AdminRepository;
use OpenSendForm\Auth\PasswordHasher;
use OpenSendForm\Auth\RecoveryCodes;
use OpenSendForm\Clock\SystemClock;
use OpenSendForm\Config;
use OpenSendForm\Form\FormRepository;
use OpenSendForm\Install\Paths;
use OpenSendForm\Mail\DeliverabilityChecker;
use OpenSendForm\Mail\DeliveryService;
use OpenSendForm\Install\ConfigWriter;
use OpenSendForm\Mail\MessageBuilder;
use OpenSendForm\Mail\PhpMailerMailer;
use OpenSendForm\Mail\SystemDnsResolver;
use OpenSendForm\Monitor\CurlHttpClient;
use OpenSendForm\Monitor\MonitorRepository;
use OpenSendForm\Monitor\MonitorService;
use OpenSendForm\Monitor\RealSleeper;
use OpenSendForm\Storage\Database;
use OpenSendForm\Storage\MigrationRunner;
use OpenSendForm\Submission\SubmissionRepository;
use OpenSendForm\Version;

require dirname(__DIR__) . '/vendor/autoload.php';

/**
 * OpenSendForm command-line tool.
 *
 * Plain argv parsing, no libraries. Connects to the configured database,
 * applies any pending migrations, then dispatches a single command.
 */

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? null;
$args = array_slice($argv, 2);

if ($command === null) {
    fwrite(STDERR, usage());
    exit(1);
}

// install:status only inspects files (config + lock); it must NOT connect to
// or create a database, so it runs before the connect/migrate boot below.
if ($command === 'install:status') {
    exit(cmdInstallStatus());
}

// migrate is the explicit, human-run counterpart to the silent auto-migrate
// every other command performs at boot below: it reports what it did instead
// of applying pending migrations quietly, and it refuses to touch a database
// before the browser installer has run. Safe to run repeatedly.
if ($command === 'migrate') {
    exit(cmdMigrate());
}

// version reports the app version plus the live schema state. It runs BEFORE
// the auto-migrate boot below on purpose: migrating first would always report
// zero pending, defeating the point of the pending-migration count.
if ($command === 'version') {
    exit(cmdVersion());
}

try {
    $paths = Paths::production();
    $config = Config::load($paths->configPath);
    $db = Database::connect($config->dbDsn(), $config->dbUser(), $config->dbPass());
    (new MigrationRunner($db, $paths->migrationsPath))->migrate();

    switch ($command) {
        case 'form:create':
            exit(cmdFormCreate($db, $args));
        case 'form:list':
            exit(cmdFormList($db));
        case 'form:enable':
            exit(cmdFormSetActive($db, $args, true));
        case 'form:disable':
            exit(cmdFormSetActive($db, $args, false));
        case 'form:turnstile':
            exit(cmdFormTurnstile($db, $args));
        case 'form:delete':
            exit(cmdFormDelete($db, $args));
        case 'admin:create':
            exit(cmdAdminCreate($db, $args));
        case 'admin:delete':
            exit(cmdAdminDelete($db, $args));
        case 'mail:retry':
            exit(cmdMailRetry($db, $config));
        case 'mail:test':
            exit(cmdMailTest($config, $args));
        case 'mail:status':
            exit(cmdMailStatus($config));
        case 'submissions:list':
            exit(cmdSubmissionsList($db, $args));
        case 'submissions:purge':
            exit(cmdSubmissionsPurge($db, $args));
        case 'monitor:run':
            exit(cmdMonitorRun($db, $config, $paths));
        case 'monitor:status':
            exit(cmdMonitorStatus($db, $config, $paths));
        default:
            fwrite(STDERR, "Unknown command: {$command}\n\n" . usage());
            exit(1);
    }
} catch (Throwable $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    exit(1);
}

/**
 * form:create --name= --recipient= --origin= (repeatable)
 */
function cmdFormCreate(Database $db, array $args): int
{
    $name = null;
    $recipient = null;
    $origins = [];

    foreach ($args as $arg) {
        if (str_starts_with($arg, '--name=')) {
            $name = substr($arg, strlen('--name='));
        } elseif (str_starts_with($arg, '--recipient=')) {
            $recipient = substr($arg, strlen('--recipient='));
        } elseif (str_starts_with($arg, '--origin=')) {
            $origins[] = substr($arg, strlen('--origin='));
        } else {
            fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
            return 1;
        }
    }

    if ($name === null || $recipient === null || $origins === []) {
        fwrite(STDERR, "form:create requires --name, --recipient and at least one --origin\n\n" . usage());
        return 1;
    }

    $form = (new FormRepository($db))->createForm($name, $recipient, $origins);

    fwrite(STDOUT, "Created form #{$form['id']} \"{$form['name']}\"\n");
    fwrite(STDOUT, "  form_key:   {$form['form_key']}\n");
    fwrite(STDOUT, "  recipient:  {$form['recipient_email']}\n");
    fwrite(STDOUT, '  origins:    ' . implode(', ', $form['allowed_origins']) . "\n");

    return 0;
}

/**
 * form:list
 */
function cmdFormList(Database $db): int
{
    $forms = (new FormRepository($db))->listForms();

    if ($forms === []) {
        fwrite(STDOUT, "No forms yet.\n");
        return 0;
    }

    foreach ($forms as $form) {
        $state = $form['is_active'] === 1 ? 'active' : 'disabled';
        $nojs = $form['allow_nojs'] === 1 ? ' [allow_nojs]' : '';
        fwrite(STDOUT, sprintf(
            "#%d  %s  [%s]%s  %s -> %s  origins: %s\n",
            $form['id'],
            $form['form_key'],
            $state,
            $nojs,
            $form['name'],
            $form['recipient_email'],
            implode(', ', $form['allowed_origins'])
        ));
    }

    return 0;
}

/**
 * form:enable ID / form:disable ID
 */
function cmdFormSetActive(Database $db, array $args, bool $active): int
{
    $id = $args[0] ?? null;
    if ($id === null || !ctype_digit($id)) {
        $verb = $active ? 'enable' : 'disable';
        fwrite(STDERR, "form:{$verb} requires a numeric form ID\n\n" . usage());
        return 1;
    }

    $repo = new FormRepository($db);
    $updated = $repo->setActive((int) $id, $active);

    if (!$updated) {
        fwrite(STDERR, "No form found with ID {$id}\n");
        return 1;
    }

    $verb = $active ? 'enabled' : 'disabled';
    fwrite(STDOUT, "Form #{$id} {$verb}.\n");

    return 0;
}

/**
 * form:turnstile ID --sitekey=X --secret=Y  (enable)
 * form:turnstile ID --disable               (clear both)
 *
 * Turnstile is per form and both-or-neither: enabling needs both keys, and
 * --disable clears them together. The secret is stored but never exposed by
 * any endpoint.
 */
function cmdFormTurnstile(Database $db, array $args): int
{
    $id = $args[0] ?? null;
    if ($id === null || !ctype_digit($id)) {
        fwrite(STDERR, "form:turnstile requires a numeric form ID\n\n" . usage());
        return 1;
    }

    $sitekey = null;
    $secret = null;
    $disable = false;

    foreach (array_slice($args, 1) as $arg) {
        if ($arg === '--disable') {
            $disable = true;
        } elseif (str_starts_with($arg, '--sitekey=')) {
            $sitekey = substr($arg, strlen('--sitekey='));
        } elseif (str_starts_with($arg, '--secret=')) {
            $secret = substr($arg, strlen('--secret='));
        } else {
            fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
            return 1;
        }
    }

    if ($disable) {
        if ($sitekey !== null || $secret !== null) {
            fwrite(STDERR, "form:turnstile --disable takes no --sitekey/--secret\n\n" . usage());
            return 1;
        }
    } elseif ($sitekey === null || $secret === null) {
        fwrite(STDERR, "form:turnstile requires --sitekey and --secret (or --disable)\n\n" . usage());
        return 1;
    }

    $repo = new FormRepository($db);
    // setTurnstile enforces both-or-neither; the validation above already
    // guarantees a well-formed pair, so it will not throw here.
    $updated = $disable
        ? $repo->setTurnstile((int) $id, null, null)
        : $repo->setTurnstile((int) $id, $sitekey, $secret);

    if (!$updated) {
        fwrite(STDERR, "No form found with ID {$id}\n");
        return 1;
    }

    fwrite(STDOUT, $disable
        ? "Turnstile disabled for form #{$id}.\n"
        : "Turnstile enabled for form #{$id}.\n");

    return 0;
}

/**
 * form:delete ID
 *
 * Permanently deletes a form and CASCADES to all its stored submissions,
 * printing the form details and how many submissions went with it. Like
 * admin:delete there is NO interactive confirmation: shell access to run
 * `bin/osf` is already the higher privilege, so a prompt here would add no
 * real protection. Refuses an unknown ID with a nonzero exit.
 */
function cmdFormDelete(Database $db, array $args): int
{
    $id = $args[0] ?? null;
    if ($id === null || !ctype_digit($id)) {
        fwrite(STDERR, "form:delete requires a numeric form ID\n\n" . usage());
        return 1;
    }

    $forms = new FormRepository($db);
    $submissions = new SubmissionRepository($db);

    $form = $forms->findById((int) $id);
    if ($form === null) {
        fwrite(STDERR, "No form found with ID {$id}\n");
        return 1;
    }

    // Cascade: submissions first so the count is known, then the form row.
    $deleted = $submissions->deleteAllForForm((int) $id);
    $forms->deleteForm((int) $id);

    fwrite(STDOUT, sprintf(
        "Deleted form #%d \"%s\" (%s) and %d submission%s.\n",
        (int) $form['id'],
        $form['name'],
        $form['form_key'],
        $deleted,
        $deleted === 1 ? '' : 's'
    ));

    return 0;
}

/**
 * admin:create --email= --name=
 *
 * Creates an administrator, prompting for the password interactively so it
 * never lands in shell history or argv. Input is hidden via `stty` when a TTY
 * is available; otherwise it falls back to visible input with a warning.
 * Refuses passwords shorter than 12 characters. Prints nothing sensitive.
 */
function cmdAdminCreate(Database $db, array $args): int
{
    $email = null;
    $name = null;

    foreach ($args as $arg) {
        if (str_starts_with($arg, '--email=')) {
            $email = substr($arg, strlen('--email='));
        } elseif (str_starts_with($arg, '--name=')) {
            $name = substr($arg, strlen('--name='));
        } else {
            fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
            return 1;
        }
    }

    if ($email === null || $name === null) {
        fwrite(STDERR, "admin:create requires --email and --name\n\n" . usage());
        return 1;
    }

    $email = trim($email);
    if (filter_var($email, FILTER_VALIDATE_EMAIL) === false) {
        fwrite(STDERR, "admin:create requires a valid --email\n");
        return 1;
    }
    if (trim($name) === '') {
        fwrite(STDERR, "admin:create requires a non-empty --name\n");
        return 1;
    }

    $hasher = new PasswordHasher();
    $repo = new AdminRepository($db, $hasher, new RecoveryCodes($hasher));

    if ($repo->findByEmail($email) !== null) {
        fwrite(STDERR, "An admin with that email already exists.\n");
        return 1;
    }

    $password = promptHidden('Password (min 12 characters): ');
    $confirm = promptHidden('Confirm password: ');

    if ($password !== $confirm) {
        fwrite(STDERR, "Passwords do not match.\n");
        return 1;
    }
    if (strlen($password) < 12) {
        fwrite(STDERR, "Password too weak: must be at least 12 characters.\n");
        return 1;
    }

    $admin = $repo->createAdmin($email, $name, $password);

    fwrite(STDOUT, "Created admin #{$admin['id']} <{$admin['email']}> ({$admin['display_name']}).\n");
    fwrite(STDOUT, "Sign in at /admin/login\n");

    return 0;
}

/**
 * admin:delete ID
 *
 * Permanently deletes an administrator. Refuses to delete the last remaining
 * ACTIVE admin (deleting an inactive one is always allowed). Unlike the web
 * UI's delete confirmation, this does NOT ask for a password: shell access
 * to run `bin/osf` is already a higher privilege than the admin panel
 * itself, so re-proving a web password here would not add any real
 * protection — the operator already has full control of the installation.
 */
function cmdAdminDelete(Database $db, array $args): int
{
    $id = $args[0] ?? null;
    if ($id === null || !ctype_digit($id)) {
        fwrite(STDERR, "admin:delete requires a numeric admin ID\n\n" . usage());
        return 1;
    }

    $hasher = new PasswordHasher();
    $repo = new AdminRepository($db, $hasher, new RecoveryCodes($hasher));

    $target = $repo->findById((int) $id);
    if ($target === null) {
        fwrite(STDERR, "No admin found with ID {$id}\n");
        return 1;
    }

    if ((int) $target['is_active'] === 1 && $repo->countActive() <= 1) {
        fwrite(STDERR, "Refusing: \"{$target['email']}\" is the last active admin.\n");
        return 1;
    }

    $repo->deleteAdmin((int) $id);

    fwrite(STDOUT, "Deleted admin #{$id} <{$target['email']}> ({$target['display_name']}).\n");

    return 0;
}

/**
 * Prompt for a secret on STDIN, hiding the typed characters when a TTY and
 * `stty` are both available. Falls back to visible input with a warning so
 * the command still works in a non-interactive or minimal environment.
 */
function promptHidden(string $label): string
{
    $sttyAvailable = function_exists('shell_exec')
        && defined('STDIN')
        && stream_isatty(STDIN)
        && trim((string) @shell_exec('command -v stty 2>/dev/null')) !== '';

    if (!$sttyAvailable) {
        fwrite(STDOUT, $label . '(WARNING: input will be visible) ');
        $value = fgets(STDIN);

        return rtrim($value === false ? '' : $value, "\r\n");
    }

    fwrite(STDOUT, $label);
    $previous = trim((string) shell_exec('stty -g'));
    shell_exec('stty -echo');
    $value = fgets(STDIN);
    // Restore the original terminal settings, then echo the newline the
    // hidden Enter keystroke swallowed.
    shell_exec('stty ' . ($previous !== '' ? escapeshellarg($previous) : 'echo'));
    fwrite(STDOUT, "\n");

    return rtrim($value === false ? '' : $value, "\r\n");
}

/**
 * mail:retry — re-attempt every submission the sweep finds due: failed
 * submissions whose backoff has elapsed AND never-attempted 'received'
 * submissions accepted while mail was off/unavailable.
 *
 * Intended for a cPanel cron entry. Prints a one-line summary and always
 * exits 0 so a transient mail outage never marks the cron job as failing.
 */
function cmdMailRetry(Database $db, Config $config): int
{
    $delivery = buildDeliveryService($db, $config);
    $summary = $delivery->retryDue();

    fwrite(STDOUT, sprintf(
        "mail:retry — attempted %d: sent %d, failed %d, dead %d, skipped %d\n",
        $summary['attempted'],
        $summary[DeliveryService::RESULT_SENT],
        $summary[DeliveryService::RESULT_FAILED],
        $summary[DeliveryService::RESULT_DEAD],
        $summary[DeliveryService::RESULT_SKIPPED]
    ));

    return 0;
}

/**
 * mail:test --to=ADDRESS — send a fixed message through the configured SMTP.
 *
 * The CLI form of the installer's future test-send. Exits 0 on success, 1 on
 * failure (printing the error).
 */
function cmdMailTest(Config $config, array $args): int
{
    $to = null;
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--to=')) {
            $to = substr($arg, strlen('--to='));
        } else {
            fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
            return 1;
        }
    }

    if ($to === null || filter_var($to, FILTER_VALIDATE_EMAIL) === false) {
        fwrite(STDERR, "mail:test requires a valid --to=ADDRESS\n\n" . usage());
        return 1;
    }

    $mailer = new PhpMailerMailer($config);
    try {
        $mailer->send(
            $to,
            null,
            'OpenSendForm test message',
            "This is a test message from OpenSendForm.\n\n"
            . "If you received it, your SMTP settings are working."
        );
    } catch (Throwable $e) {
        fwrite(STDERR, "mail:test FAILED sending to {$to}: " . $e->getMessage() . "\n");
        return 1;
    }

    fwrite(STDOUT, "mail:test OK — message sent to {$to} via {$config->smtpHost()}:{$config->smtpPort()}\n");

    return 0;
}

/**
 * mail:status — print the current mail configuration state (never a secret) and
 * run the three deliverability DNS checks for the configured From domain.
 *
 * The DNS lookups are LIVE (they use the system resolver). Offline, the resolver
 * returns nothing and each record is simply reported as not found — the command
 * still completes and exits 0.
 */
function cmdMailStatus(Config $config): int
{
    $host = $config->smtpHost();
    $from = $config->mailFromAddress();

    fwrite(STDOUT, "Mail configuration\n");
    fwrite(STDOUT, '  Sending:       ' . ($config->mailEnabled() ? 'ENABLED' : 'off') . "\n");
    fwrite(STDOUT, '  SMTP host:     ' . ($host !== '' ? 'set (' . $host . ')' : 'not set') . "\n");
    fwrite(STDOUT, '  SMTP port:     ' . $config->smtpPort() . "\n");
    fwrite(STDOUT, '  Encryption:    ' . $config->smtpEncryption() . "\n");
    fwrite(STDOUT, '  Auth:          ' . ($config->smtpUser() !== '' ? 'username set' : 'no username') . "\n");
    fwrite(STDOUT, '  From address:  ' . ($from !== '' ? $from : '(none)') . "\n");

    $domain = DeliverabilityChecker::domainOf($from);
    if ($domain === '') {
        fwrite(STDOUT, "\nNo valid From domain, so deliverability records cannot be checked.\n");
        return 0;
    }

    fwrite(STDOUT, "\nDeliverability for {$domain} (live DNS lookups):\n");

    $checker = new DeliverabilityChecker(new SystemDnsResolver());
    // Seed the recommended DMARC report mailbox with the From address (the CLI
    // has no logged-in admin to default to).
    $report = $checker->check($from, $from);

    foreach (['spf', 'dkim', 'dmarc'] as $key) {
        $check = $report[$key];
        $mark = $check['ok'] ? 'OK ' : '-- ';
        $state = $check['ok'] ? 'published' : 'not found';
        fwrite(STDOUT, sprintf("  [%s] %-5s %s\n", $mark, strtoupper($key), $state));
        if (!$check['ok'] && (string) $check['recommended'] !== '') {
            fwrite(STDOUT, '        add TXT ' . $check['name'] . ' → ' . $check['recommended'] . "\n");
        }
    }

    return 0;
}

/**
 * submissions:list [--status=X] — metadata only; never any submitted content.
 */
function cmdSubmissionsList(Database $db, array $args): int
{
    $status = null;
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--status=')) {
            $status = substr($arg, strlen('--status='));
        } else {
            fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
            return 1;
        }
    }

    $rows = (new SubmissionRepository($db))->listSummaries($status);

    if ($rows === []) {
        fwrite(STDOUT, "No submissions" . ($status !== null ? " with status '{$status}'" : '') . ".\n");
        return 0;
    }

    foreach ($rows as $row) {
        fwrite(STDOUT, sprintf(
            "#%d  %s  %s  %s  attempts=%d\n",
            (int) $row['id'],
            (string) ($row['form_key'] ?? '(deleted form)'),
            (string) $row['created_at'],
            (string) $row['status'],
            (int) $row['attempts']
        ));
    }

    return 0;
}

/**
 * submissions:purge [--status=STATUS] [--form=ID]
 *
 * Bulk-deletes submissions and prints how many were removed. With no flags it
 * removes every submission; --status=STATUS narrows to one delivery status;
 * --form=ID removes every submission for one form (refusing an unknown form
 * ID). The two filters are NOT combinable — deleteAll is status-scoped and
 * deleteAllForForm is form-scoped, mirroring the admin panel, which likewise
 * offers no status+form bulk delete. Metadata only; never prints content.
 */
function cmdSubmissionsPurge(Database $db, array $args): int
{
    $status = null;
    $formId = null;

    foreach ($args as $arg) {
        if (str_starts_with($arg, '--status=')) {
            $status = substr($arg, strlen('--status='));
        } elseif (str_starts_with($arg, '--form=')) {
            $formId = substr($arg, strlen('--form='));
        } else {
            fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
            return 1;
        }
    }

    if ($status !== null && $formId !== null) {
        fwrite(STDERR, "submissions:purge does not support --status and --form together; use one at a time.\n");
        return 1;
    }

    $repo = new SubmissionRepository($db);

    if ($formId !== null) {
        if (!ctype_digit($formId)) {
            fwrite(STDERR, "submissions:purge --form requires a numeric form ID\n\n" . usage());
            return 1;
        }
        if ((new FormRepository($db))->findById((int) $formId) === null) {
            fwrite(STDERR, "No form found with ID {$formId}\n");
            return 1;
        }

        $deleted = $repo->deleteAllForForm((int) $formId);
        fwrite(STDOUT, sprintf(
            "Deleted %d submission%s for form #%d.\n",
            $deleted,
            $deleted === 1 ? '' : 's',
            (int) $formId
        ));

        return 0;
    }

    $deleted = $repo->deleteAll($status);
    fwrite(STDOUT, sprintf(
        "Deleted %d %ssubmission%s.\n",
        $deleted,
        $status === null ? '' : $status . ' ',
        $deleted === 1 ? '' : 's'
    ));

    return 0;
}

/**
 * migrate — apply any pending migrations to the installed database and report
 * what it did. Refuses to run (exit 1) before the browser installer has
 * produced a config file and lock; idempotent otherwise.
 */
function cmdMigrate(): int
{
    $paths = Paths::production();

    if (!$paths->isInstalled()) {
        fwrite(STDERR, "OpenSendForm is not installed yet — run the browser installer first.\n");
        return 1;
    }

    try {
        $config = Config::load($paths->configPath);
        $db = Database::connect($config->dbDsn(), $config->dbUser(), $config->dbPass());
        $applied = (new MigrationRunner($db, $paths->migrationsPath))->migrate();
    } catch (Throwable $e) {
        fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
        return 1;
    }

    if ($applied === []) {
        fwrite(STDOUT, "Already up to date.\n");
        return 0;
    }

    foreach ($applied as $file) {
        fwrite(STDOUT, "Applied {$file}\n");
    }

    return 0;
}

/**
 * version — print the application version plus the live schema state (current
 * schema version = highest applied migration, and how many migrations are
 * still pending). This is the CLI companion to the dashboard's staleness
 * banner: after replacing the files with a new release, `bin/osf version` tells
 * you at a glance whether you still need to run `bin/osf migrate`.
 *
 * It reads the database but never writes to it — in particular it does NOT
 * auto-migrate, so the pending count is truthful. On a system that has not been
 * installed yet (and with no DB_DSN override in the environment) it reports the
 * app version only and leaves the schema fields as not-applicable, so it never
 * creates a stray database.
 */
function cmdVersion(): int
{
    fwrite(STDOUT, 'OpenSendForm ' . Version::STRING . "\n");

    $paths = Paths::production();
    $dsnOverride = getenv('DB_DSN');
    $haveDb = $paths->isInstalled() || (is_string($dsnOverride) && $dsnOverride !== '');

    if (!$haveDb) {
        fwrite(STDOUT, "Schema version:     n/a (not installed)\n");
        fwrite(STDOUT, "Pending migrations: n/a (not installed)\n");
        return 0;
    }

    try {
        $config = Config::load($paths->configPath);
        $db = Database::connect($config->dbDsn(), $config->dbUser(), $config->dbPass());
        $runner = new MigrationRunner($db, $paths->migrationsPath);
        $applied = $runner->appliedVersions();
        $schema = $applied === [] ? 0 : max($applied);
        $pending = $runner->pendingCount();
    } catch (Throwable $e) {
        fwrite(STDERR, 'Error reading schema: ' . $e->getMessage() . "\n");
        return 1;
    }

    fwrite(STDOUT, sprintf("Schema version:     %d\n", $schema));
    fwrite(STDOUT, sprintf("Pending migrations: %d\n", $pending));

    return 0;
}

/**
 * install:status — report whether the app is installed, without touching the
 * database. Prints the config file's presence and, when the lock exists, its
 * recorded install timestamp and version. Never prints any secret.
 */
function cmdInstallStatus(): int
{
    $paths = Paths::production();

    $configPresent = is_file($paths->configPath);
    $lockPresent = is_file($paths->lockPath);
    $installed = $configPresent && $lockPresent;

    fwrite(STDOUT, 'Status:      ' . ($installed ? 'installed' : 'NOT installed') . "\n");
    fwrite(STDOUT, 'Config file: ' . ($configPresent ? 'present' : 'missing')
        . ' (' . $paths->configPath . ")\n");
    fwrite(STDOUT, 'Lock file:   ' . ($lockPresent ? 'present' : 'missing')
        . ' (' . $paths->lockPath . ")\n");

    if ($lockPresent) {
        $raw = (string) @file_get_contents($paths->lockPath);
        $meta = json_decode($raw, true);
        if (is_array($meta)) {
            fwrite(STDOUT, 'Installed:   ' . (string) ($meta['installed_at'] ?? 'unknown') . " UTC\n");
            fwrite(STDOUT, 'Version:     ' . (string) ($meta['version'] ?? 'unknown') . "\n");
        }
    }

    return 0;
}

/**
 * monitor:run — the single cron entry point for synthetic monitoring.
 *
 * Each run purges expired synthetic submissions, checks the canary form plus
 * any other active form now due (staggered), records every result and sends one
 * alert email on each ok<->fail transition. It ALWAYS exits 0 when checks ran —
 * a failing check is reported and alerted, not treated as a monitor error — and
 * exits nonzero only when the monitor itself cannot operate: here, when an alert
 * email it needed to send could not be sent (cron output is then the backstop).
 *
 * Recommended cPanel cron (hourly):
 *   0 * * * * /usr/local/bin/php /home/USER/opensendform/bin/osf monitor:run
 */
function cmdMonitorRun(Database $db, Config $config, Paths $paths): int
{
    $monitor = buildMonitorService($db, $config, $paths);
    $summary = $monitor->run();

    if ($summary['secret_generated']) {
        fwrite(STDOUT, "Generated MONITOR_SECRET and wrote it to the config file.\n");
    }

    fwrite(STDOUT, sprintf(
        "monitor:run — checked %d form(s): %d ok, %d failed; purged %d synthetic; %d alert(s) sent.\n",
        $summary['checks_ran'],
        $summary['checks_ran'] - $summary['failures'],
        $summary['failures'],
        $summary['purged'],
        $summary['alerts_sent']
    ));

    foreach ($summary['results'] as $result) {
        fwrite(STDOUT, sprintf(
            "  [%s] #%d %s — %s\n",
            $result['ok'] ? 'OK' : '--',
            $result['form_id'],
            $result['form_name'],
            $result['detail']
        ));
    }

    // The one nonzero case: a needed alert email could not be sent. Print it so
    // cron mails the operator — the backstop when SMTP alerting is itself down.
    if ($summary['alert_error'] !== null) {
        fwrite(STDERR, 'monitor:run could not alert: ' . $summary['alert_error'] . "\n");
        return 1;
    }

    return 0;
}

/**
 * monitor:status — per-form last check, result and next due time. Read-only.
 */
function cmdMonitorStatus(Database $db, Config $config, Paths $paths): int
{
    $monitor = buildMonitorService($db, $config, $paths);
    $rows = $monitor->status();

    if ($rows === []) {
        fwrite(STDOUT, "No active forms to monitor.\n");
        return 0;
    }

    foreach ($rows as $row) {
        $result = $row['last_ok'] === null ? 'never checked' : ($row['last_ok'] ? 'ok' : 'FAILED');
        fwrite(STDOUT, sprintf(
            "#%d %s%s\n    last check: %s (%s)\n    next due:   %s\n",
            $row['form_id'],
            $row['form_name'],
            $row['is_canary'] ? ' [canary]' : '',
            $row['last_checked_at'] ?? 'never',
            $result,
            $row['next_due']
        ));
    }

    return 0;
}

/**
 * Assemble the MonitorService from real production collaborators: a curl HTTP
 * client, the SMTP transport for alerts, the config writer for the first-run
 * MONITOR_SECRET write-back, the system clock and a real sleeper.
 */
function buildMonitorService(Database $db, Config $config, Paths $paths): MonitorService
{
    $hasher = new PasswordHasher();

    return new MonitorService(
        new CurlHttpClient(),
        new FormRepository($db),
        new SubmissionRepository($db),
        new MonitorRepository($db),
        new PhpMailerMailer($config),
        new AdminRepository($db, $hasher, new RecoveryCodes($hasher)),
        $config,
        new ConfigWriter($paths->configPath),
        new SystemClock(),
        new RealSleeper()
    );
}

/**
 * Assemble a DeliveryService from the configured SMTP transport.
 */
function buildDeliveryService(Database $db, Config $config): DeliveryService
{
    return new DeliveryService(
        new SubmissionRepository($db),
        new FormRepository($db),
        new MessageBuilder(),
        new PhpMailerMailer($config),
        $config,
        new SystemClock()
    );
}

function usage(): string
{
    return <<<TXT
    OpenSendForm CLI

    Usage:
      bin/osf form:create --name=NAME --recipient=EMAIL --origin=ORIGIN [--origin=ORIGIN ...]
      bin/osf form:list
      bin/osf form:enable ID
      bin/osf form:disable ID
      bin/osf form:turnstile ID --sitekey=KEY --secret=SECRET
      bin/osf form:turnstile ID --disable
      bin/osf form:delete ID
      bin/osf admin:create --email=EMAIL --name=NAME
      bin/osf admin:delete ID
      bin/osf mail:retry
      bin/osf mail:test --to=ADDRESS
      bin/osf mail:status
      bin/osf submissions:list [--status=STATUS]
      bin/osf submissions:purge [--status=STATUS] [--form=ID]
      bin/osf monitor:run
      bin/osf monitor:status
      bin/osf install:status
      bin/osf migrate
      bin/osf version

    Notes:
      --origin may be repeated to allow more than one origin.
      An origin is scheme+host+optional port, e.g. https://example.com
      form:turnstile enables per-form Cloudflare Turnstile (both keys
        required) or --disable clears both; the secret is never exposed.
      form:delete permanently removes a form and CASCADES to all its stored
        submissions, printing both counts; refuses an unknown ID. No prompt —
        shell access is already the higher privilege.
      admin:create prompts for the password interactively (hidden when a
        TTY is available); it must be at least 12 characters.
      admin:delete permanently removes an admin; refuses the last active
        admin. No password prompt — shell access is already the higher
        privilege.
      mail:retry re-sends submissions whose delivery is due: failed
        submissions whose backoff has elapsed, plus never-attempted
        'received' submissions accepted while mail was disabled or SMTP was
        unavailable (intended for a cPanel cron entry); it always exits 0.
      mail:status prints the mail config state (no secrets) and runs live
        SPF/DKIM/DMARC DNS lookups for the From domain (skips when offline).
      submissions:list shows metadata only — never submitted content.
      submissions:purge bulk-deletes submissions and prints the count: no
        flags removes every submission, --status limits to one status, --form
        removes one form's submissions (unknown ID refused). --status and
        --form cannot be combined.
      monitor:run is the single cron entry point for synthetic monitoring: it
        sends real fake-but-marked submissions through the FULL public pipeline
        (token -> min-time -> POST -> store -> SMTP delivery to the form's real
        recipient), records each result, alerts on ok<->fail transitions and
        auto-purges expired synthetic submissions. It always exits 0 when checks
        ran (failures are alerted, not errors) and nonzero only when it cannot
        alert. Recommended cPanel cron (hourly):
          0 * * * * /usr/local/bin/php /home/USER/opensendform/bin/osf monitor:run
        (adjust the PHP path and project path for your host; the same style as
        the mail:retry cron line.)
      monitor:status prints each active form's last check, result and next due
        time; read-only.
      install:status reports whether the browser installer has run (config +
        lock files); it never connects to or creates a database.
      migrate applies any pending schema migrations and reports what it did;
        refuses to run before the browser installer has produced a config.
        Every other command already auto-migrates at boot, but this is the
        way to apply an update BEFORE running anything else. Safe to re-run.
      version prints the app version, the current schema version and the
        number of pending migrations — read-only, and never auto-migrates.

    TXT;
}
