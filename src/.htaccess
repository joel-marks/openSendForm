# Block all web access to this directory (fallback layout only).
#
# The recommended setup points the domain's document root at public/, so this
# directory already sits OUTSIDE the web root and can never be requested. This
# file is the safety net for hosts that don't let you move the document root:
# when the whole osf-php/ folder is the web root, these rules make sure a
# browser can't fetch the server-side files kept here.

# Apache 2.4 and newer: deny every request.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 and older: same effect, older directive syntax.
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
